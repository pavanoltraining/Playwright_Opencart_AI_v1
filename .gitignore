#  Dependencies 
node_modules/


# Environment & secrets 
.env

#  Playwright test artifacts 
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

#  Reports 
/reports/
/allure-results/
/allure-report/
/custom-report/

#  Tool / IDE config (local caches, not project files) 
.claude/
.commandcode/
.playwright-cli/
.playwright-mcp/

